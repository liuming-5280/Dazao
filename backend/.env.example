
# 应用名称；显示在 FastAPI /docs 文档标题中。
APP_NAME=延安精神学习助手 API | Yan'an Spirit Learning Assistant API

# 以下两个变量是旧版 Nginx 部署配置；当前 backend/docker-compose.yml 未使用它们。
# Nginx 数据目录示例路径。
NGINX_DATA_PATH=/home/ubuntu
# 前端页面目录示例路径。
FRONTEND_PAGE=/home/ubuntu

# Elasticsearch 配置。
# Elasticsearch 内置 elastic 用户密码示例；部署时请设置为自己的强密码。
ELASTIC_PASSWORD=infini_rag_flow
# 旧版或本机直连配置使用的 Elasticsearch 端口；当前 Compose 内部使用 9200，未读取此变量。
ES_PORT=1200
# Elasticsearch 镜像版本示例；当前 Compose 文件直接指定了镜像版本，未读取此变量。
STACK_VERSION=8.11.3
# Elasticsearch 容器内存限制，单位为字节；当前 Compose 使用此变量设置容器内存上限。
MEM_LIMIT=8073741824
# 容器时区；当前 Compose 使用此变量设置 Elasticsearch 时区。
TIMEZONE='Asia/Shanghai'

# DashScope API 密钥；请在本机 backend/.env 中填写，不要提交或分享真实密钥。
DASHSCOPE_API_KEY=
# DashScope OpenAI 兼容接口地址；聊天和向量调用会读取此值。
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Docker 网络内 PostgreSQL 连接串示例；当前 Compose 会用 gsk_pg 服务地址覆盖它。
# DATABASE_URL=postgresql://postgres:pg123456@gsk_pg:5432/gsk
# 本机直接运行后端时使用的 PostgreSQL 连接串；需确保本机数据库地址、端口和账号正确。
DATABASE_URL=postgresql://postgres:pg123456@localhost:5432/gsk

# 本机直接运行后端时使用的 Elasticsearch 地址示例；当前 Compose 会用 es01:9200 覆盖它。
ES_HOST=http://localhost:1200
# Docker 网络内 Elasticsearch 地址示例；当前 Compose 已设置此值。
# ES_HOST=http://es01:9200
